n = 6
mat = matrix(c(0, 0, 0, 0,0,0,
0, 0.6, 1, 0.3,0.5, 0,
0, 0.3, 0.6, 1,1, 0,
0, 1, 0.6, 0.3,0.5, 0,
0, 0.3, 0.6, 1,0.3, 0,
0, 0, 0, 0, 0,0), nrow = n, byrow = TRUE)
# Plot the object
mat_plot = t(apply(mat, 2, rev)) # for correct orientation
image(mat_plot, col=gray(seq(0, 1, length=256)),
axes=FALSE, useRaster=TRUE,asp=1)
